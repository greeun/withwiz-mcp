{
  "packageManager": "pnpm@11.10.0",
  "name": "@withwiz/mcp",
  "version": "0.2.0",
  "description": "MCP server connection and auth standardization for withwiz apps; each app supplies its own tools",
  "license": "MIT",
  "author": "withwiz",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeun/withwiz-mcp.git"
  },
  "homepage": "https://github.com/greeun/withwiz-mcp#readme",
  "bugs": {
    "url": "https://github.com/greeun/withwiz-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "server",
    "tools"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "prisma/fragment.prisma",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.29.0 <2",
    "zod": "^3.25 || ^4",
    "@withwiz/toolkit": ">=0.13"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0",
    "zod": "^4.6.7",
    "zod3": "npm:zod@^3.25.76",
    "zod4": "npm:zod@^4.6.7",
    "@withwiz/toolkit": "0.26.0"
  },
  "peerDependenciesMeta": {
    "@withwiz/toolkit": {
      "optional": true
    }
  }
}
